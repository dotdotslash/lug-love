{
  "name": "lug-love-payload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:types",
    "seed": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload seed"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "express": "^4.18.0",
    "payload": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  }
}
